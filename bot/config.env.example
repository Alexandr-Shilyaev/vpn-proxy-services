# Скопируйте в /etc/vpn-proxy-services/bot.env и заполните.
# chmod 600 /etc/vpn-proxy-services/bot.env

# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Кому разрешено управлять (ваш Telegram user id, узнать у @userinfobot).
# Можно несколько через запятую: 11111111,22222222
ADMIN_IDS=11111111

# Корень проекта на сервере (там лежат подпапки протоколов: amneziawg/ и т.д.)
REPO_DIR=/opt/vpn-proxy-services
